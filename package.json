{
  "name": "interview",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare:pdf": "node scripts/prepare-pdf-assets.mjs",
    "predev": "npm run prepare:pdf",
    "prebuild": "npm run prepare:pdf",
    "test:sharing": "node tests/library-sharing.test.mjs",
    "test:auth": "node --experimental-strip-types tests/auth-errors.test.mjs",
    "test:audio": "node --experimental-strip-types tests/focus-audio.test.mjs",
    "test:pomodoro": "node --experimental-strip-types tests/pomodoro.test.mjs",
    "test:quiz": "node --experimental-strip-types tests/quiz.test.mjs",
    "dev": "vitepress dev docs",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vitepress build docs",
    "preview": "vitepress preview docs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pdfjs-dist": "^6.4.299",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "vitepress": "^1.6.4",
    "vue-tsc": "^3.0.0"
  },
  "engines": { "node": ">=22" },
  "overrides": {
    "vitepress": { "vite": "^6.4.4" }
  }
}
